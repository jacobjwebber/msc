MF=	Makefile_smp

CC=	upcc

CFLAGS=	--pthreads -T 8

SRC= life.c

EXE= life.x

OBJ= $(SRC:.c=.o)

#
# No need to edit below this line
#

.SUFFIXES:
.SUFFIXES: .c .o


all:	$(EXE)

.c.o:
	$(CC) $(CFLAGS) -c $<

$(EXE):	$(OBJ)
	$(CC) $(CFLAGS) -o $@ $(OBJ) $(LFLAGS)

$(OBJ): $(MF)

clean:
	rm -f $(EXE) *.o 

