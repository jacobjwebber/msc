set terminal pdf enhanced font "cmr10"
set output "gcc_times.pdf"
set xlabel "Terrain Size (Terrain Elements{\267}10^{-3})"
set ylabel "time (s)"
set style data linespoints
set key below
set format x "%.0s"

plot "graphs/times_gcc_cliph-none_graph" with lines lc rgb "blue" title "no optimisation", '' lc rgb "blue" notitle, \
    "graphs/times_gcc_cliphO1_graph" with lines lc rgb "red" title "-O1 optimisation", '' lc rgb "red" notitle,  \
    "graphs/times_gcc_cliphO2_graph" with lines lc rgb "green" title "-O2 optimisation", '' lc rgb "green" notitle, \
    "graphs/times_gcc_cliphO3_graph" with lines lc rgb "purple" title "-O3 optimisation", '' lc rgb "purple" notitle


set output "pgi_times.pdf"

plot "graphs/times_pgi_cliph-none_graph" with lines lc rgb "blue" title "no optimisation", '' lc rgb "blue" notitle, \
    "graphs/times_pgi_cliphO1_graph" with lines lc rgb "red" title "-O1 optimisation", '' lc rgb "red" notitle,  \
    "graphs/times_pgi_cliphO2_graph" with lines lc rgb "green" title "-O2 optimisation", '' lc rgb "green" notitle, \
    "graphs/times_pgi_cliphO3_graph" with lines lc rgb "purple" title "-O3 optimisation", '' lc rgb "purple" notitle

set output "gcc_nocopy.pdf"

plot "graphs/times_gcc_cliph-none_graph" with lines lc rgb "blue" title "no optimisation", '' lc rgb "blue" notitle, \
    "graphs/times_gcc_cliph-copy-reduce_graph" with lines lc rgb "red" title "-ftree-copy-prop optimisation", '' lc rgb "red" notitle,  \

set output "best.pdf"
plot "graphs/times_gcc_cliphO3_graph" with lines lc rgb "blue" title "gcc with -O3", '' lc rgb "blue" notitle, \
    "graphs/times_pgi_cliphO3_graph" with lines lc rgb "red" title "pgcc with -O3", '' lc rgb "red" notitle,  \


